{
  "name": "synotheo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "check": "npm run check --workspace=apps/web",
    "fix": "npm run lint --workspace=apps/web -- --fix && npm run format --workspace=apps/web"
  }
}
